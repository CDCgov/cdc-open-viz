{
  "type": "chart",
  "visualizationType": "Sankey",
  "title": "Patient Care Pathway",
  "showTitle": true,
  "enableTooltips": true,
  "heights": {
    "vertical": 500,
    "horizontal": 750
  },
  "general": {
    "palette": {
      "isReversed": true,
      "version": "2.0",
      "name": "sequential_bluereverse"
    }
  },
  "data": [
    { "example_source": "Screened", "example_target": "Eligible", "example_value": 850 },
    { "example_source": "Screened", "example_target": "Ineligible", "example_value": 150 },
    { "example_source": "Eligible", "example_target": "Enrolled", "example_value": 700 },
    { "example_source": "Eligible", "example_target": "Declined", "example_value": 150 },
    { "example_source": "Enrolled", "example_target": "Completed Treatment", "example_value": 580 },
    { "example_source": "Enrolled", "example_target": "Dropped Out", "example_value": 120 },
    { "example_source": "Completed Treatment", "example_target": "Recovered", "example_value": 460 },
    { "example_source": "Completed Treatment", "example_target": "Ongoing Care", "example_value": 120 }
  ],
  "sankey": {
    "iterations": 1,
    "rxValue": 0.9,
    "horizontalScrollWidth": 900,
    "margin": {
      "margin_y": 25,
      "margin_x": 0
    },
    "columns": {
      "source": "example_source",
      "target": "example_target",
      "value": "example_value"
    },
    "nodeSize": {
      "nodeWidth": 26
    },
    "nodePadding": 55,
    "nodeFontColor": "black",
    "nodeColor": {
      "default": "#005eaa",
      "inactive": "#808080"
    },
    "linkColor": {
      "default": "#7bafd4",
      "inactive": "#D3D3D3"
    },
    "opacity": {
      "nodeOpacityDefault": 1.0,
      "nodeOpacityInactive": 0.1,
      "LinkOpacityDefault": 0.6,
      "LinkOpacityInactive": 0.1
    },
    "nodeValueStyle": {
      "textBefore": "(",
      "textAfter": ")"
    }
  },
  "table": {
    "show": false,
    "expanded": false,
    "label": "Data Table",
    "caption": ""
  },
  "legend": {
    "hide": true
  }
}
