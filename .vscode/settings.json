{
    "chatgpt.commentCodeLensEnabled": false,

    // Vitest Test Explorer: index both the unit-test project and the
    // storybook browser project defined in vitest.config.ts so story
    // play functions surface as runnable tests.
    "vitest.enable": true,
    "vitest.rootConfig": "${workspaceFolder}/vitest.config.ts",

    // Keep test navigation lightweight when iterating on stories.
    "testing.automaticallyOpenPeekView": "never"
}